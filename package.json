    "@solidjs/start": "2.0.5",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "cookie-es": "3.1.1",
    "js-md5": "0.9.2",
    "lucide-solid": "1.47.0",
    "nitro": "3.0.260903-beta",
    "resend": "6.28.1",
    "solid-js": "1.9.15",
    "vite": "8.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-solid": "0.18.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite-node": "6.0.0",
    "vitest": "5.0.1"
