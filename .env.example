# Copy to .env (or .env.local) and fill in. Never commit real values.
# Server-only values are read at runtime. VITE_* values are baked into the browser bundle.

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=                # browser-safe
SUPABASE_SERVICE_ROLE_KEY=               # server only. Never expose.
# Browser copies of the two public values above (same values).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Payaza (hackathon build). Dashboard: Settings, Developers, Generate Keys.
# Test keys start PZ78-PKTEST- / PZ78-SKTEST-; live keys PZ78-PKLIVE- / PZ78-SKLIVE-.
PAYAZA_PUBLIC_KEY=                       # authenticates API calls (base64, "Payaza" prefix) and is the Web Checkout merchant_key
PAYAZA_SECRET_KEY=                       # signs webhooks (x-payaza-signature). Server only. Never expose.
PAYAZA_BASE_URL=https://api.payaza.africa/live   # same for test and live; MERIDIAN_MODE picks X-TenantID
PAYAZA_TRANSACTION_PIN=                  # 6-digit PIN that authorises Transfers. Server only. Never logged.
# Sandbox only. Payaza's test merchant holds no payout float, so Transfers cannot
# succeed there. true = mark the payout settled without calling Payaza and say
# so on the timeline. Ignored when MERIDIAN_MODE=live.
PAYAZA_SIMULATE_PAYOUTS=true

# Routed providers (server only). Meridian asks each one that can carry a payment
# for a price and uses the cheapest; the rest are backups. A provider without its
# keys gives estimates and simulated payments in sandbox, and is skipped in live.
KOTANI_API_KEY=
KOTANI_WEBHOOK_SECRET=
KOTANI_BASE_URL=https://sandbox-api.kotanipay.io/api/v3
YELLOWCARD_API_KEY=
YELLOWCARD_SECRET=                       # signs every request (HMAC). Never logged.
YELLOWCARD_BUSINESS_ID=
YELLOWCARD_BASE_URL=https://sandbox.api.yellowcard.io
KLASHA_USERNAME=
KLASHA_PASSWORD=
KLASHA_PUBLIC_KEY=                       # x-auth-token
KLASHA_ENCRYPTION_KEY=
KLASHA_BUSINESS_ID=
KLASHA_BASE_URL=https://dev.kcp-api.klasha.com
MINISEND_API_KEY=
MINISEND_BASE_URL=https://merchant.minisend.xyz
MINISEND_REFUND_ADDRESS=                 # Meridian's EVM address for refunds of stray USDC
# Sandbox only: providers to treat as down, comma separated (e.g. yellowcard), to show fallback.
PARTNER_SIMULATE_FAIL=

# Email
RESEND_API_KEY=
EMAIL_FROM="Meridian <hello@meridian.appify.co.ke>"
ADMIN_EMAIL=                             # alerts, lead notifications, held and failed payments

# App
APP_URL=http://localhost:3000            # locally with ngrok: the https tunnel URL. Production: https://meridian.appify.co.ke
MERIDIAN_MODE=sandbox                    # sandbox | live
JOBS_SECRET=                             # bearer for /api/jobs/*. On Vercel also set CRON_SECRET to the same value.
