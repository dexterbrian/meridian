# Copy to .env (or .env.local) and fill in. Never commit real values.
# Server-only values are read at runtime. VITE_* values are baked into the browser bundle.

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=                # browser-safe
SUPABASE_SERVICE_ROLE_KEY=               # server only. Never expose.
# Browser copies of the two public values above (same values).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=


# Routed providers (server only). Meridian asks each one that can carry a payment
# for a price and uses the cheapest; the rest are backups. A provider without its
# keys gives estimates and simulated payments in sandbox, and is skipped in live.
KOTANI_PAY_PUBLIC_KEY=                   # the API key: Authorization: Bearer <key>
KOTANI_PAY_SECRET_KEY=                   # signs Kotani's webhooks (X-Kotani-Signature)
KOTANI_WEBHOOK_SECRET=                   # only if Kotani issues a separate webhook secret
# Kotani gives each account its own environment URLs. Checked 13 October 2026:
# the sandbox is kotanipay.com (not .io) and v3 routes sit under /api/v3.
KOTANI_BASE_URL=https://sandbox-api.kotanipay.com/api/v3
# The stablecoin Kotani settles on between the onramp and the offramp. Never shown to users.
KOTANI_CHAIN=STELLAR
KOTANI_TOKEN=USDC
YELLOWCARD_API_KEY=
YELLOWCARD_SECRET=                       # signs every request (HMAC). Never logged.
YELLOWCARD_BUSINESS_ID=
YELLOWCARD_BASE_URL=https://sandbox.api.yellowcard.io
KLASHA_USERNAME=                         # your Klasha dashboard email: Klasha issues API tokens per login
KLASHA_PASSWORD=                         # your Klasha dashboard password. Server only. Never logged.
KLASHA_PUBLIC_KEY=                       # x-auth-token
KLASHA_ENCRYPTION_KEY=                   # the 24-character "new encryption key" (3DES)
KLASHA_BUSINESS_ID=                      # Merchant Business ID on the same dashboard page
KLASHA_BASE_URL=https://dev.kcp-api.klasha.com
KLASHA_WEBHOOK_TOKEN=                    # Klasha doesn't sign webhooks: give it /api/webhooks/klasha?token=<this>
PASSPOINT_MERCHANT_ID=
PASSPOINT_API_KEY=                       # buys a short-lived token. Server only.
PASSPOINT_USER_APP_CONTEXT=              # path part given at onboarding, for sign-in
PASSPOINT_PAYMENT_CONTEXT=paypass        # path part for payments, as in the docs
PASSPOINT_BASE_URL=https://dev.mypasspoint.com
# Sandbox only: providers to treat as down, comma separated (e.g. yellowcard), to show fallback.
PARTNER_SIMULATE_FAIL=

# Email
RESEND_API_KEY=
EMAIL_FROM="Meridian <hello@meridian.appify.co.ke>"
ADMIN_EMAIL=                             # alerts, lead notifications, held and failed payments

# App
APP_URL=http://localhost:3000            # locally with ngrok: the https tunnel URL. Production: https://meridian.appify.co.ke
MERIDIAN_MODE=sandbox                    # sandbox | live
JOBS_SECRET=                             # bearer for /api/jobs/*. On Vercel also set CRON_SECRET to the same value.
